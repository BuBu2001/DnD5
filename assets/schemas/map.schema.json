{
  "$schema_version": 1,
  "schema_id": "schemas/map.schema.json",
  "type": "object",
  "required": ["$schema", "schema_version", "id", "name", "grid", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tile_size_px": { "type": "integer", "minimum": 8, "maximum": 256 },
    "grid": {
      "type": "object",
      "required": ["columns", "rows", "cell_feet"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 512 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 512 },
        "cell_feet": { "type": "integer", "minimum": 5, "maximum": 5 }
      }
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "passable"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "passable": { "type": "boolean" },
          "difficult_terrain": { "type": "boolean" },
          "cover": { "type": "string", "enum": ["None", "Half", "ThreeQuarters", "Full"] },
          "texture_key": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "rows"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["terrain", "objects", "light"] },
          "visible": { "type": "boolean" },
          "rows": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "column", "row"],
        "properties": {
          "entity_id": { "type": "string", "minLength": 3 },
          "column": { "type": "integer", "minimum": 0 },
          "row": { "type": "integer", "minimum": 0 },
          "facing": { "type": "string", "enum": ["North", "East", "South", "West"] }
        }
      }
    }
  }
}
