  "comment": "Состав характеристик и таблица модификаторов (DOC-01 FR-K10, FR-K11). Модификатор вычисляется формулой floor((Score-10)/2); таблица приведена для сверки и для тестов (AC-K01). Значения вне 8..20 считаются той же формулой.",
  "abilities": [
    { "code": "Str", "name": "Сила",          "name_en": "Strength",     "affects": "Ближний бой, переносимый вес, навык «Атлетика»" },
    { "code": "Dex", "name": "Ловкость",      "name_en": "Dexterity",    "affects": "Скрытность, дальний бой, инициатива, КД (если нет тяжёлой брони)" },
    { "code": "Con", "name": "Телосложение",  "name_en": "Constitution", "affects": "Хиты, концентрация на поддержании заклинаний" },
    { "code": "Int", "name": "Интеллект",     "name_en": "Intelligence", "affects": "Магия волшебника, навыки «История», «Расследование»" },
    { "code": "Wis", "name": "Мудрость",      "name_en": "Wisdom",       "affects": "Восприятие, выживание, магия жреца/друида/следопыта" },
    { "code": "Cha", "name": "Харизма",       "name_en": "Charisma",     "affects": "Убеждение, запугивание, обман, магия барда/колдуна/паладина/чародея" }
